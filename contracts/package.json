{
  "name": "@muara/contracts",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "sizes": "forge build --sizes --skip test --skip script",
    "fmt": "forge fmt",
    "deploy:tokens:base": "forge script script/DeployTokens.s.sol:DeployTokens --rpc-url base_sepolia --broadcast --slow --verify",
    "deploy:tokens:arb": "forge script script/DeployTokens.s.sol:DeployTokens --rpc-url arbitrum_sepolia --broadcast --slow --verify",
    "wire:base": "forge script script/WireLayerZero.s.sol:WireLayerZero --rpc-url base_sepolia --broadcast --slow",
    "wire:arb": "forge script script/WireLayerZero.s.sol:WireLayerZero --rpc-url arbitrum_sepolia --broadcast --slow",
    "allowlist:base": "forge script script/SyncAllowlist.s.sol:SyncAllowlist --rpc-url base_sepolia --broadcast --slow",
    "allowlist:arb": "forge script script/SyncAllowlist.s.sol:SyncAllowlist --rpc-url arbitrum_sepolia --broadcast --slow",
    "deploy:hub": "forge script script/DeployHub.s.sol:DeployHub --rpc-url base_sepolia --broadcast --slow --verify",
    "seed": "forge script script/Seed.s.sol:Seed --rpc-url base_sepolia --broadcast --slow",
    "redeploy:hub": "forge script script/RedeployHub.s.sol:RedeployHub --rpc-url base_sepolia --broadcast --slow --verify"
  },
  "devDependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.168",
    "@layerzerolabs/lz-evm-v1-0.7": "3.0.168",
    "@layerzerolabs/oapp-evm": "0.4.1",
    "@layerzerolabs/oft-evm": "4.0.1",
    "@layerzerolabs/test-devtools-evm-foundry": "8.0.1",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "solidity-bytes-utils": "0.8.4"
  }
}
