# Copy to deploy/.env on the VPS. Read by docker compose (DOMAIN, VITE_*) and the backend container.

# Hosts served by Caddy with automatic HTTPS. Both DNS A records must point at the VPS.
DOMAIN=muara.willian.asia
API_DOMAIN=api.muara.willian.asia

# RPC. Free tiers cap eth_getLogs ranges (public Base: 200 blocks, Alchemy free: 10); the
# indexer adapts, but a paid RPC makes the first backfill much faster.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Backend wallets. Both need Base Sepolia ETH for gas.
KEEPER_PRIVATE_KEY=0x...
PRICE_UPDATER_PRIVATE_KEY=0x...

# Deployer: admin for the scenario panel, owner of the allowlists, funds faucet gas on both chains.
PRIVATE_KEY=0x...
ADMIN_ADDRESS=0x875Ef8cbB730d8901C8793A82BEC8dd5a2d53Ac1

# Modules to run. Drop "faucet" to run without PRIVATE_KEY.
MODULES=prices,keeper,indexer,faucet
FAUCET_GAS_ETH=0.003

# Browser origins allowed to call the API.
CORS_ORIGINS=https://muara.willian.asia

# Baked into the frontend at build time (rebuild to change).
VITE_API_URL=https://api.muara.willian.asia/api
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_WALLETCONNECT_PROJECT_ID=

# Optional tuning (defaults shown)
# ANCHOR_PRICE=150
# SCENARIO_DURATION_MS=15000
# SCENARIO_STEPS=8
# PRICE_REFRESH_AGE_S=1200
# LOG_CHUNK_BLOCKS=200
# HERMES_API_KEY=        # only for `anchor pyth`
