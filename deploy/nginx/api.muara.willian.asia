# Host nginx site for the Muara backend. Upstream is the web container's API listener on
# loopback:3201, which forwards to the backend container. CORS is the backend's own.
# Install like the frontend site, then `sudo certbot --nginx -d api.muara.willian.asia`.
server {
    listen 80;
    listen [::]:80;
    server_name api.muara.willian.asia;

    location / {
        proxy_pass http://127.0.0.1:3201;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
