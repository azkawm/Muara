# Host nginx site for the Muara frontend. Upstream is the web container on loopback:3200.
# Install: sudo cp deploy/nginx/muara.willian.asia /etc/nginx/sites-available/ &&
#          sudo ln -s /etc/nginx/sites-available/muara.willian.asia /etc/nginx/sites-enabled/
# Then `sudo certbot --nginx -d muara.willian.asia` adds TLS.
server {
    listen 80;
    listen [::]:80;
    server_name muara.willian.asia;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
