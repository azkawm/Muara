# Root env for the backend and TypeScript scripts during local development.
# Contract deploys read contracts/.env (see contracts/.env.example). The backend loads this
# file first, then fills any gaps from contracts/.env, so shared values need not be copied.
# On the VPS, the backend reads deploy/.env instead (see deploy/.env.example).

# RPC. Free RPC tiers cap eth_getLogs ranges (public Base Sepolia: 200 blocks, Alchemy free:
# 10); the indexer detects the cap and adapts.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Admin: the deployer. Signs scenario panel requests; `pnpm admin` uses PRIVATE_KEY.
PRIVATE_KEY=
ADDRESS=

# Backend wallets. Both need Base Sepolia ETH for gas.
KEEPER_PRIVATE_KEY=
PRICE_UPDATER_PRIVATE_KEY=

# Backend server (defaults shown)
# PORT=8787
# DB_PATH=./data/muara.sqlite
# CORS_ORIGINS=http://localhost:5173
# MODULES=prices,keeper,indexer
# LOG_LEVEL=info
# LOG_PRETTY=true

# Price scenarios (defaults shown)
# ANCHOR_PRICE=150
# SCENARIO_DURATION_MS=15000
# SCENARIO_STEPS=8
# HEARTBEAT_INTERVAL_MS=60000
# PRICE_REFRESH_AGE_S=1200
# HERMES_API_KEY=        # only for `pnpm admin anchor pyth`; public Hermes now answers 401

# Keeper and indexer (defaults shown)
# KEEPER_INTERVAL_MS=5000
# INDEXER_INTERVAL_MS=4000
# LOG_CHUNK_BLOCKS=200
# LZ_POLL_INTERVAL_MS=15000
