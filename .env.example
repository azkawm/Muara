# Root env for the backend and TypeScript scripts.
# Contract deploys read contracts/.env instead; see contracts/.env.example.

# RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Explorer verification (Etherscan v2 key works for both chains)
ETHERSCAN_API_KEY=

# Deployer: owner of every contract, USDC liquidity provider and background short seller
PRIVATE_KEY=
ADDRESS=

# Demo wallets (allowlisted and funded by the seed script)
RINA_ADDRESS=
BUDI_ADDRESS=
KEEPER_ADDRESS=

# Backend wallets
KEEPER_PRIVATE_KEY=
PRICE_UPDATER_PRIVATE_KEY=
PRICE_UPDATER_ADDRESS=

# Optional: native gas sent to each demo wallet during seeding, in wei
SEED_GAS_WEI=0
