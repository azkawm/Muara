# Copy to apps/web/.env.local. Vite only exposes VITE_* variables to the browser.

# Backend base URL. "/api" works in dev (Vite proxy) and in production (Caddy).
VITE_API_URL=/api

# Browser RPCs. Public endpoints work; a dedicated RPC avoids rate limits during the demo.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional WalletConnect Cloud project id (cloud.reown.com). Without it, only browser
# extension wallets (MetaMask, Rabby, Coinbase) are offered.
VITE_WALLETCONNECT_PROJECT_ID=
